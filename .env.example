# Never commit `.env`. Every product under apps/ carries its own .env.example;
# this file is the estate contract, not a replacement for those.
#
# Production secrets come from Cerulean Vault (KV v2) and are resolved from
# vault://<mount>/<path>#<KEY> references at deploy time.
# Identity is Cerulean Authentik (OIDC); DNS, TLS and the public proxy are Cerulean.

# The shared model gateway every agent product calls.
OMNIROUTE_BASE_URL=https://gateway.innotel.us/v1
OMNIROUTE_API_KEY=

# Autonomy level the gateway allows per request, read by the agent products.
OMNIROUTE_MAX_AUTONOMY=auto

# Where a product that needs storage puts it (ONYX owns the volume).
STORAGE_ROOT=/srv/storage
