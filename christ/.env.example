# CHRIST — copy to .env and fill in. Nothing here is a secret you should commit:
# `.env` and `.env.*` are ignored (except this template), and a deployment's real
# values live in Cerulean Vault (SecretOps, KV v2) as `vault://` references.

# ── Cerulean Vault ──────────────────────────────────────────────────────────
# Local development reads this file; production resolves `vault://` instead.
CERULEAN_VAULT_ADDR=
CERULEAN_VAULT_TOKEN=

# ── the voice plane ──────────────────────────────────────────────────────────
CANTUS_DOMAIN=estate.local
CANTUS_SECRET=
CANTUS_CONTROL_TOKEN=
SWITCH_PORT=8188

# ── the PSTN border ──────────────────────────────────────────────────────────
# The address the carrier must send to: this box's public IPv4.
PUBLIC_IP=
VOIPMS_SIP_HOST=
VOIPMS_SIP_PORT=5060
VOIPMS_SIP_USERNAME=
VOIPMS_SIP_PASSWORD=
VOIPMS_SIP_FROM_USER=
VOIPMS_SIP_DOMAIN=
# `on` offers and answers RTP/SAVP with an SDES key. The sub-account at the
# carrier has to agree, or every call is refused with 488 in one direction.
SIP_SRTP=on

# ── the platform ─────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@estate.local
ADMIN_PASSWORD=
PUBLIC_URL=http://localhost:8090
TELNO_PORT=8090

# ── the front door ───────────────────────────────────────────────────────────
CHRIST_PORT=8001

# ── attached stacks (AI capabilities live in their own repos) ────────────────
# Capstone and dograh, started from apps/capstone.
CAPSTONE_URL=
DOGRAH_URL=
# OmniRoute. Leave empty when the omniroute profile is running in this compose.
OMNIROUTE_URL=
GENIE_URL=
CLAUDE_MEM_URL=
ONTRAK_URL=
WEBMAIL_URL=
OPENSMS_URL=
