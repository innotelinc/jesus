# The compiled agent document is a build artefact, not a source file: it is
# regenerated by `node cli.js souls` from souls/ and must never drift by hand.
out/

# Local secrets. .env.example is the committed template.
.env
.env.*
!.env.example

# The gateway's remembered encryption choice, written by the container.
state/

# OS and editor noise
.DS_Store
Thumbs.db
