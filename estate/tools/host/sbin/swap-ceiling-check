#!/bin/bash
# swap-ceiling-check — flags an Incus instance that is filling its memory or swap
# ceiling. Runs on each estate host from a timer; prints nothing when everything
# is comfortable, so a non-empty log is the alert.
#
# Why: on 2026-10-25 atheniq sat at 1.57 GB of its 2 GiB swap for five hours after
# a boot burst, and nothing noticed. A ceiling is a hard bound — when the instance
# reaches it the next allocation is an OOM kill inside its own cgroup (the
# intended, local failure, audit §15.1) — so it has to be watched *before* it is
# reached, not explained afterwards.
#
# Memory is measured as the **working set** — anon + slab + shmem + sock from
# memory.stat — not memory.current, which counts reclaimable page cache and would
# cry wolf on a host that is merely warm. Swap is memory.swap.current against
# limits.memory.swap.
#
# Thresholds, per instance:
#   swap    >= 50 % of the swap ceiling   WARN   (>= 80 %: CRIT)
#   working >= 90 % of limits.memory      WARN   (>= 97 %: CRIT)
# Instances with no swap limit (Incus reports 0 = unlimited) are only checked for
# memory. The check never changes or restarts anything.
set -uo pipefail

WARN_PCT=50
CRIT_PCT=80
MEM_WARN_PCT=90
MEM_CRIT_PCT=97
LOG=/var/log/swap-ceiling-check.log

say() { printf '%s %s %s\n' "$(date -Is)" "$(hostname)" "$*"; }

# incus reports limits as sizes ("2GiB", "8053063680"); normalise to bytes
to_bytes() {
  case "$1" in
    '' ) echo 0 ;;
    *GiB) awk -v v="${1%GiB}" 'BEGIN{printf "%.0f", v*1073741824}' ;;
    *MiB) awk -v v="${1%MiB}" 'BEGIN{printf "%.0f", v*1048576}' ;;
    *KiB) awk -v v="${1%KiB}" 'BEGIN{printf "%.0f", v*1024}' ;;
    *GB)  awk -v v="${1%GB}"  'BEGIN{printf "%.0f", v*1000000000}' ;;
    *MB)  awk -v v="${1%MB}"  'BEGIN{printf "%.0f", v*1000000}' ;;
    *[0-9]) echo "$1" ;;
    *) echo 0 ;;
  esac
}

pct() { # $1 = used, $2 = limit
  [ "${2:-0}" -gt 0 ] 2>/dev/null || { echo 0; return; }
  awk -v u="$1" -v l="$2" 'BEGIN{printf "%d", (u*100)/l}'
}

alerts=0
for c in $(incus list --format csv -c n,s 2>/dev/null | awk -F, '$2=="RUNNING"{print $1}'); do
  sw_max=$(to_bytes "$(incus config get "$c" limits.memory.swap 2>/dev/null)")
  mem_max=$(to_bytes "$(incus config get "$c" limits.memory 2>/dev/null)")
  stats=$(incus exec "$c" -- cat /sys/fs/cgroup/memory.stat 2>/dev/null | tr -d '\r')
  sw_cur=$(incus exec "$c" -- cat /sys/fs/cgroup/memory.swap.current 2>/dev/null | tr -d '\r')
  [ -n "$sw_cur" ] || sw_cur=0
  # cgroup v2 memory.stat reports bytes: anon + slab + shmem + sock
  working=$(printf '%s\n' "$stats" | awk '
    $1=="anon"||$1=="slab"||$1=="shmem"||$1=="sock" {s+=$2}
    END{printf "%.0f", s}')
  working=${working:-0}

  if [ "$sw_max" -gt 0 ] && [ "$sw_cur" -gt 0 ]; then
    p=$(pct "$sw_cur" "$sw_max")
    if [ "$p" -ge "$CRIT_PCT" ]; then
      say "CRIT  $c swap ${p}% of ceiling ($((sw_cur/1048576)) MiB of $((sw_max/1048576)) MiB) — an OOM kill is one burst away"; alerts=$((alerts+1))
    elif [ "$p" -ge "$WARN_PCT" ]; then
      say "WARN  $c swap ${p}% of ceiling ($((sw_cur/1048576)) MiB of $((sw_max/1048576)) MiB)"; alerts=$((alerts+1))
    fi
  fi

  if [ "$mem_max" -gt 0 ] && [ "$working" -gt 0 ]; then
    p=$(pct "$working" "$mem_max")
    if [ "$p" -ge "$MEM_CRIT_PCT" ]; then
      say "CRIT  $c working set ${p}% of cap ($((working/1048576)) MiB of $((mem_max/1048576)) MiB)"; alerts=$((alerts+1))
    elif [ "$p" -ge "$MEM_WARN_PCT" ]; then
      say "WARN  $c working set ${p}% of cap ($((working/1048576)) MiB of $((mem_max/1048576)) MiB)"; alerts=$((alerts+1))
    fi
  fi
done

[ "$alerts" -gt 0 ] && exit 1
exit 0
