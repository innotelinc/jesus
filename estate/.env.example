# The demo estate's settings. `./up.sh` writes this file with generated secrets
# on first run; edit it afterwards and `./up.sh up` applies the change.
#
# Every Cantus node in an estate shares CANTUS_SECRET: it signs the relay
# registrations, so two switches with different secrets cannot see each other.
CANTUS_DOMAIN=estate.local
CANTUS_SECRET=
CANTUS_CONTROL_TOKEN=

# dograh dials ARI as this user. Put the same pair in its telephony
# configuration — the switch does not accept anonymous ARI.
CANTUS_ARI_USER=dograh
CANTUS_ARI_PASSWORD=

# Host ports. The switch listens on 8088 inside the network whatever this says;
# SWITCH_PORT is the host side, and it doubles as the browser softphone origin,
# so it is published on every interface on purpose.
ESTATE_PORT=8000
SWITCH_PORT=8188
CANTUS_SIGNAL_PORT=7443
CANTUS_RELAY_PORT=7444
TELNO_PORT=8090

# Public URL the platform puts in links and provisioning files. On a Vultr demo
# this is http://<ip>:<TELNO_PORT> unless a domain and proxy sit in front.
PUBLIC_URL=http://localhost:8090

# Set when a Capstone stack is reachable from the console container, e.g.
# http://capstone-dashboard:80 — otherwise the console reports it as absent.
CAPSTONE_URL=

ADMIN_EMAIL=admin@estate.local
# Empty means "generate one and print it once in the container log".
ADMIN_PASSWORD=
DEFAULT_COUNTRY=US
LOG_LEVEL=info
