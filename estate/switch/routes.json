{
  "version": 1,
  "default": { "reject": 3 },
  "routes": [
    {
      "name": "demo-front-desk",
      "when": { "to": "101@*" },
      "then": [{ "answer": {} }, { "bridge": { "to": "*" } }]
    },
    {
      "name": "demo-interview-room",
      "when": { "to": "102@*" },
      "then": [{ "answer": {} }, { "bridge": { "to": "*" } }]
    },
    {
      "name": "demo-agent",
      "when": { "to": "8000@*" },
      "then": [{ "answer": {} }, { "ari": { "app": "dograh" } }]
    },
    {
      "name": "demo-voicemail",
      "when": { "to": "103@*" },
      "then": [
        { "answer": {} },
        { "play": { "file": "greeting.wav" } },
        { "record": { "name": "demo-voicemail", "max_ms": 60000 } },
        { "reject": 0 }
      ]
    }
  ]
}
