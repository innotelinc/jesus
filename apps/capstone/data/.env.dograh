# Voice platform (compose project: `dograh`) — every value its compose files
# interpolate. Started by scripts/boot-stack.sh (behind systemd/capstone.service),
# or by hand:
#
#   docker compose --project-directory dograh/upstream -p dograh \
#     -f dograh/upstream/docker-compose.yaml \
#     -f docker-compose.dograh-capstone.yml \
#     --env-file data/.env.dograh --profile tunnel up -d --pull=never
#
# `dograh` owns postgres, redis, minio, api, ui, speaches, kokoro, grist, n8n and
# the SigNoz pair. The Capstone project (docker-compose.yml) owns the Control
# Center, the TTS shim and the SSO gateways, and its run must NOT name any of the
# services above — their container names and host ports are already taken, and
# compose aborts on the collision before it reaches any service. `data/.env.resolved`
# is the Capstone stack's env; the two projects are independent and nothing below
# is read from there.
#
# Every variable the upstream files interpolate is set here explicitly, to the
# value this deployment runs, so a boot does not silently depend on a default
# buried in the upstream compose. The one thing that cannot be "set fresh" is
# what the volumes already hold — see Credentials at the bottom.

ENVIRONMENT=production
# This host's LAN address — the estate's variable for every bind a remote edge
# has to reach. Used here for minio's media port (the edge's `/voice-audio/`
# route; docker-compose.dograh-capstone.yml note 6). 192.168.1.30 is this box.
PJSIP_MEDIA_ADDRESS=192.168.1.30
# Base registry for the tags the upstream file derives itself (minio). api/ui
# carry their own pins below because the fork/stock question is not a registry
# base.
REGISTRY=dograhai
# uvicorn workers. The upstream default is 1; this host has 2 cores, so 4 only
# pays off while calls queue — it is what the deployment ran when it was sized.
FASTAPI_WORKERS=4

# ── Public identity ────────────────────────────────────────────────────────
# The origin this deployment advertises: recording/transcript links the API
# hands out are built from MINIO_PUBLIC_ENDPOINT, and the OIDC callback host is
# derived from the origin. `dograh.capstone.innotel.us` and the apex
# `capstone.innotel.us` both reach the app, and the Authentik provider registers
# both; the name below is the one .env, CI (DOGRAH_BASE) and the smoke tests use.
# Changing it means changing the edge host and the IdP registration with it.
PUBLIC_BASE_URL=https://dograh.capstone.innotel.us
PUBLIC_HOST=dograh.capstone.innotel.us
BACKEND_API_ENDPOINT=https://dograh.capstone.innotel.us
# The API serves the bucket through the edge (`/voice-audio/`), so this is the
# app's own origin — not the minio service, which is unreachable from a browser.
MINIO_PUBLIC_ENDPOINT=https://dograh.capstone.innotel.us

# ── WebRTC / TURN ──────────────────────────────────────────────────────────
# SERVER_IP is this host's LAN address (the address every other part of the
# estate reaches this box on); it is what the API hands to coturn/ICE helpers.
SERVER_IP=192.168.1.30
# The coturn in front of this stack is the PBX's (project `zeus`, container
# pbx-coturn, listening on 3478 with the public relay range). A browser is told
# to reach TURN at the host it reached the app on — the estate's own rule for
# browser-facing endpoints (dashboard-backend/app/hosts.py) — so this is the
# app's public name, not a `turn.` host: `turn.capstone.innotel.us` has no DNS
# record, and a name that does not resolve never gets a server-reflexive
# candidate. Off-LAN clients need 3478/tcp+udp and 49152–49251/udp forwarded.
TURN_HOST=dograh.capstone.innotel.us
# (TURN_SECRET is with the other credentials, at the bottom.)
ENABLE_COTURN=true
FORCE_TURN_RELAY=false
ICE_INBOUND_POLICY=
ICE_OUTBOUND_POLICY=

# ── Telephony / ARI ────────────────────────────────────────────────────────
# The VoIP.ms/FreePBX side dials back into this API and the ARI websocket opens
# without a token (pbx/asterisk/websocket_client.conf), so the token gate must
# stay off until that client sends one. DOGRAH_DEVOPS_SECRET is unused here.
ENABLE_ARI_MANAGER=true
ENABLE_CAMPAIGN_ORCHESTRATOR=true
TELEPHONY_WS_TOKEN_ENFORCE=false
TELEPHONY_WS_TOKEN_SECRET=
DOGRAH_DEVOPS_SECRET=

# ── Call length ────────────────────────────────────────────────────────────
# The interview workflows ship max_call_duration=0 ("no limit"); the schema
# accepts 0 only when the deployment ceiling is also 0, otherwise it is
# greater_than 0 and the write is rejected HTTP 422. Kept in step with
# docker-compose.dograh-capstone.yml.
MAX_CALL_DURATION_SECONDS=0
DEFAULT_MAX_CALL_DURATION_SECONDS=300
# The concurrency limiter's slot age-out. Must stay >= the longest call you
# allow, or a live call's slot is purged and the org limit under-counts.
STALE_CALL_TIMEOUT_SECONDS=7200

# ── Product flags ──────────────────────────────────────────────────────────
ENABLE_SIGNUP=true
# This deployment's telemetry goes to the SigNoz pair below, not to PostHog.
ENABLE_TELEMETRY=false
LANGFUSE_TRACES_PUBLIC=false
# No S3: recordings live in this project's minio.
ENABLE_AWS_S3=false
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=us-east-1
S3_ADDRESSING_STYLE=
S3_SIGNATURE_VERSION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# ── Observability (project-local SigNoz) ───────────────────────────────────
# The collector in *this* project. The Capstone collector (project `capstone`,
# otel-collector) is a separate pipeline; these two do not feed each other.
ENABLE_PROMETHEUS_METRICS=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://signoz-otel-collector:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SERVICE_NAME=vai-api
SIGNOZ_OTLP_ENDPOINT=http://signoz-otel-collector:4318/v1/traces
SIGNOZ_POSTGRES_PASSWORD=signoz
# The Signoz UI's own tokenizer secret. This is the upstream file's default
# value, so it is public knowledge — rotate it (and the UI's sessions) when the
# SigNoz pair is next touched.
SIGNOZ_JWT_SECRET=0df51a148293dcf934bdf22c2c1a1be797732f98a977ecb2e7b4e851826cc67b

# ── n8n / Grist (the workflow studio) ──────────────────────────────────────
# The editor and webhook URLs are handed to browsers and to webhook callers, so
# they must be this deployment's public name — not a default belonging to
# whoever published the image.
N8N_HOST=n8n.capstone.innotel.us
N8N_EDITOR_BASE_URL=https://n8n.capstone.innotel.us/
N8N_WEBHOOK_URL=https://n8n.capstone.innotel.us/
N8N_TIMEZONE=UTC
N8N_OWNER_EMAIL=admin@localhost
# Only read the first time the owner is created (the n8n_import one-shot); the
# owner account that exists was provisioned with this value. Changing it here
# does not change the stored credential — do that in the n8n UI.
N8N_OWNER_PASSWORD=admin123
# Session signing for n8n's own logins. A known value (`change-me-in-env`, the
# upstream default) lets anyone who can reach n8n's port mint a session, so this
# is the deployment's generated secret, same as the Capstone .env carries.
N8N_USER_MANAGEMENT_JWT_SECRET=mGps5VpZmUNLINESziJuQORXo/pjManL+/IJeCO44ZagyvV6p+eF8SUR9aj+3pCr
GRIST_ADMIN_EMAIL=admin@localhost
GRIST_DOC_ID=new~kcsms7E9nU5Mg43rWKjNsX

# ── Speech sidecars ────────────────────────────────────────────────────────
# cpu-only host: kokoro for TTS, speaches for STT. The Capstone tts-shim in
# front of kokoro is the audio path the agents use (see docker-compose.yml).
KOKORO_IMAGE=ghcr.io/remsky/kokoro-fastapi-cpu:latest
SPEACHES_IMAGE=ghcr.io/speaches-ai/speaches:latest-cpu
SPEACHES_WHISPER_DEVICE=cpu
SPEACHES_WHISPER_COMPUTE_TYPE=int8
# The UI talks to the API over the project bridge, not through the edge.
BACKEND_URL=http://api:8000

# ── Cloudflare tunnel (profile: tunnel) ────────────────────────────────────
# Unset, so the tunnel cannot authenticate and the edge for this deployment is
# NPM. boot-stack.sh starts the profile, matching how this host was deployed.
# Leave the token empty unless this stack is actually fronted by a tunnel.
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARED_COMMAND=tunnel --url http://api:8000 --metrics 0.0.0.0:2000

# ── api / ui images ────────────────────────────────────────────────────────
# What this deployment runs: the upstream `dograhai/dograh-*` pair, which is the
# build that migrated this database (revision b3c1d9e4f7a2). The repo's target
# pair is the fork's `ghcr.io/innotelinc/dograh-*` (see .env / .env.example), but
# the published fork api image predates that revision — 100 migrations, no
# b3c1d9e4f7a2 — so pinning it here stops the API at startup.
#
# Pin BOTH or neither: a patched API behind an unpatched UI renders
# "Authentication required. Please refresh the page." for every signed-in user
# (docs/operations.md, "A patch only helps if the image that ships it is the one
# running"). To move to the fork pair, rebuild and ship both from the current
# `dograh/upstream` checkout — docker-compose.dograh-build.yml builds api+ui,
# and the UI needs more memory than the Capstone host is allowed to give it —
# then repoint these two and recreate both services together.
DOGRAH_API_IMAGE=dograhai/dograh-api:latest
DOGRAH_UI_IMAGE=dograhai/dograh-ui:latest

# ── Credentials ────────────────────────────────────────────────────────────
# The values below are the ones these volumes and services were created with;
# they are read here so the running stack can be recreated exactly. They do NOT
# re-key anything that already exists:
#
#   * POSTGRES_PASSWORD — applied by the postgres image at initdb only. The
#     running cluster keeps the password from its first init; change it with
#     ALTER ROLE inside the container *and* here, in one window.
#   * REDIS_PASSWORD, MINIO_ROOT_USER/PASSWORD, OSS_JWT_SECRET, TURN_SECRET —
#     read from the environment on every start, so they rotate by updating this
#     file and recreating the service together with every client of it. MinIO
#     objects are owned by MINIO_ROOT_USER: rotate the password freely, move the
#     user only with a policy/alias change.
#
# `CHANGE_ME` is the literal placeholder the deployment was first brought up
# with, and it is a known value: anyone who can reach the API could mint a token
# with it. Rotating the four env-read secrets is a maintenance-window change
# (sessions are invalidated), not something to do while calls are running.
POSTGRES_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME
OSS_JWT_SECRET=CHANGE_ME
TURN_SECRET=CHANGE_ME
