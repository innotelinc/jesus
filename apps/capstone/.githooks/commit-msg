#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════════════════
# commit-msg — block AI/assistant attribution in the commit MESSAGE.
#
# Runs with the message file as $1 (the authoritative, final message including
# any trailers a tool appended). Catches co-author trailers, "Generated by …"
# lines, and mailbox signatures before the commit is written. Pairs with the
# pre-commit hook, which guards the committed files themselves.
#
# Install (enables the guard locally):
#     git config core.hooksPath .githooks
# setup.sh on a fresh install already does this.
# ═══════════════════════════════════════════════════════════════════════════
set -uo pipefail

MSG_FILE="${1:-}"
HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=.githooks/guard-lib
# shellcheck disable=SC1091
source "$HOOK_DIR/guard-lib"

say() { printf 'guard: %s\n' "$*"; }

if [ -z "$MSG_FILE" ] || [ ! -f "$MSG_FILE" ]; then
  say "warning: no commit message file given — skipping message guard"
  exit 0
fi

if ! cat "$MSG_FILE" | guard_check_stream; then
  say "commit blocked: the message contains AI/assistant attribution."
  exit 1
fi
exit 0