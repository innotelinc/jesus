# ── Capstone interview-stack environment ──────────────────────────────────
# cp .env.example .env, then set real random secrets (openssl rand hints below)
# and the host-reachable BACKEND_API_ENDPOINT. NEVER commit the real .env.

# ══ dograh core ════════════════════════════════════════════════════════════
# REQUIRED — generate with: openssl rand -base64 48
OSS_JWT_SECRET=change-me-oss-jwt-secret

# Public origin dograh advertises. For the n8n transcript fetch to work,
# BACKEND_API_ENDPOINT must be reachable from INSIDE the n8n container:
# use the host LAN IP (e.g. http://192.168.1.63:8000) or a public URL — NOT
# localhost (n8n would resolve localhost to itself).
PUBLIC_BASE_URL=http://localhost:8000
BACKEND_API_ENDPOINT=http://localhost:8000

DOGRAH_API_IMAGE=dograhai/dograh-api:latest

POSTGRES_PASSWORD=postgres
REDIS_PASSWORD=redissecret
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ══ Local TTS / STT ════════════════════════════════════════════════════════
KOKORO_IMAGE=ghcr.io/remsky/kokoro-fastapi-cpu:latest
SPEACHES_IMAGE=ghcr.io/speaches-ai/speaches:latest-cpu
SPEACHES_WHISPER_DEVICE=cpu          # cpu | cuda | auto
SPEACHES_WHISPER_COMPUTE_TYPE=int8

# ══ LLM gateway (port 20128) ═══════════════════════════════════════════════
# OmniRoute container secrets — openssl rand -base64 48 / -hex 32 / -base64 32
OMNIROUTE_JWT_SECRET=change-me-omniroute-jwt
OMNIROUTE_API_KEY_SECRET=change-me-omniroute-api-key
OMNIROUTE_INITIAL_PASSWORD=change-me-omniroute-admin   # first login to :20128 dashboard
OMNIROUTE_WS_BRIDGE_SECRET=change-me-omniroute-ws
# Optional: when set, n8n's grading node sends Authorization: Bearer <key>.
# Required if you run a keyed host 9Router instead of the OmniRoute container.
OMNIROUTE_API_KEY=

# ══ n8n ════════════════════════════════════════════════════════════════════
N8N_HOST=localhost
N8N_EDITOR_BASE_URL=http://localhost:5678/
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_TIMEZONE=UTC
# openssl rand -base64 32
N8N_USER_MANAGEMENT_JWT_SECRET=change-me-in-env
N8N_OWNER_EMAIL=admin@localhost
N8N_OWNER_PASSWORD=admin123

# Grist doc id — create it with: python3 scripts/grist_bootstrap.py
# (that script creates the doc + Interviews table and prints the id).
GRIST_DOC_ID=new~w8ixnSUpaAEGjaH9BE7636
GRIST_ADMIN_EMAIL=admin@localhost

# n8n AI-assistant sandbox (only if you enable the instance-ai module)
SANDBOX_API_KEYS=change-me-sandbox-api-key
SANDBOX_API_RUNNER_REGISTRATION_TOKEN=change-me-runner-registration-token
SANDBOX_API_RUNNER_API_KEY=change-me-runner-key
SEARXNG_SECRET=change-me-searxng-secret

# ══ SigNoz observability ═══════════════════════════════════════════════════
SIGNOZ_POSTGRES_PASSWORD=signoz
# openssl rand -hex 32
SIGNOZ_JWT_SECRET=change-me-signoz-jwt-secret

# ══ PBX / FreePBX (docker-compose.asterisk.yml) ═════════════════════════════
HOSTNAME=voice.innotel.us

# Dograh ARI password — MUST match the "App Password" entered in dograh's
# Telephony Configurations (Stasis App Name: dograh). openssl rand -base64 24
DOGRAH_ARI_PASSWORD=

# External-media WebSocket URI Asterisk dials out to. Default reaches host-mode
# dograh-api; change only if dograh is TLS-fronted (then set wss:// + edit
# websocket_client.conf tls_enabled).
DOGRAH_WS_URI=ws://host.docker.internal:8000/api/v1/telephony/ws/ari

# AMI (used by the optional portal profile)
FREEPBX_AMI_USER=pbxportal
FREEPBX_AMI_SECRET=

# Optional VoIP.ms SIP trunk auto-config
VOIPMS_SIP_USER=
VOIPMS_SIP_PASS=
VOIPMS_SIP_SERVER=newyork1.voip.ms

# Optional: PBX Customer Portal (profile "portal")
SESSION_SECRET=
FREEPBX_CLIENT_ID=pbxportal-api
FREEPBX_CLIENT_SECRET=
