# ── Capstone Voice AI Agent Platform environment ─────────────────────────
# cp .env.example .env, then set real random secrets (openssl rand hints below)
# and the host-reachable BACKEND_API_ENDPOINT. NEVER commit the real .env.
# setup.sh fills in every secret marked "setup.sh auto-generates".

# ══ dograh core ════════════════════════════════════════════════════════════
# REQUIRED — generate with: openssl rand -base64 48
OSS_JWT_SECRET=change-me-oss-jwt-secret

# Public origin dograh advertises. BACKEND_API_ENDPOINT is what the web UI
# tells the browser to use to reach the API: it MUST be a URL the visitor's
# browser can reach (the public domain or LAN IP), NOT the Docker host gateway
# (172.17.0.1) or localhost — otherwise login fails with "Login failed".
#
# It is also used for the n8n transcript fetch, so it must be reachable from
# INSIDE the n8n container too: a public URL (https://…) or the host LAN IP
# (e.g. http://192.168.1.63:8000) both work. Set both values identically.
PUBLIC_BASE_URL=http://localhost:8000
BACKEND_API_ENDPOINT=http://localhost:8000

# Where the Control Center dashboard itself is served (its own subdomain).
# Keep PUBLIC_BASE_URL above for dograh's advertised origin — the dashboard
# has its own URL so the two can diverge (e.g. https://dashboard.<domain>).
DASHBOARD_PUBLIC_URL=http://localhost:8096

# Public base domain every NPM-proxied service hangs off. Each service gets
# its own subdomain under the canonical Capstone map: app.<domain> → :3010,
# api.<domain> → :8000, auth.<domain> → :9000 (Authentik), voice.<domain> →
# PBX WSS :8089, admin.<domain> → :8096, pbx.<domain> → :80, … (see README
# "NPM proxy hosts"). Leave empty to fall back to http://<host>:<port> links.
NPM_BASE_DOMAIN=capstone.innotel.us

# ══ Nginx Proxy Manager (reverse proxy) ════════════════════════════════════
# Credentials for scripts/npm-proxy-hosts.py, which creates/updates the NPM
# proxy hosts for every service in the README table. NPM runs outside this
# compose file (web UI on port 81 by default).
NPM_API_URL=http://127.0.0.1:81
NPM_ADMIN_EMAIL=admin@example.com
NPM_ADMIN_PASSWORD=change-me-npm-password
# Alternatively (or additionally), a persistent API token minted in NPM
# (Access → API Tokens) — skips the login above.
# NPM_API_TOKEN=
# Email used for the Let's Encrypt certificates NPM issues per proxy host.
# Defaults to GRIST_ADMIN_EMAIL; empty → hosts are created without SSL.
NPM_LETSENCRYPT_EMAIL=admin@example.com
# Docker host IP NPM forwards to (must be reachable from NPM's container).
# Defaults to PJSIP_MEDIA_ADDRESS above.
# NPM_UPSTREAM_HOST=192.168.1.47
# Optional proxy hosts to sync — only include ones whose compose profile you
# run (nocodb, portal). Comma-separated, or "all".
# NPM_INCLUDE_OPTIONAL=
# Issue ONE wildcard certificate (*.<base> + <base>) via DNS-01 and attach it
# to every proxy host, instead of one Let's Encrypt cert per host. Requires
# the DNS provider's credentials to be saved in NPM (Credentials tab) — put
# the provider slug and the credential id here. When the credentials are
# missing the sync falls back to per-host HTTP-01 certs automatically.
NPM_WILDCARD_CERT=1
# NPM_DNS_PROVIDER=cloudflare
# NPM_DNS_PROVIDER_CREDENTIALS=<id from NPM Credentials tab>

# ══ Authentik (identity provider / SSO, auth.<domain>) ════════════════════
# setup.sh auto-generates these on a fresh install and appends them to an
# existing .env on re-run (openssl rand -base64 36 / -hex 32).
AUTHENTIK_SECRET_KEY=change-me-authentik-secret-key
AUTHENTIK_TOKEN=change-me-authentik-token
AUTHENTIK_POSTGRES_PASSWORD=change-me-authentik-pg
AUTHENTIK_REDIS_PASSWORD=change-me-authentik-redis
# Bootstrap superuser created on first boot.
AUTHENTIK_BOOTSTRAP_EMAIL=admin@capstone.innotel.us
AUTHENTIK_BOOTSTRAP_PASSWORD=change-me-authentik-admin
# Public URL Authentik redirects to — https://auth.<NPM_BASE_DOMAIN> by
# default; set to http://localhost:9000 for LAN-only installs without NPM.
# AUTHENTIK_PUBLIC_URL=
# Pin the Authentik image version (ghcr.io/goauthentik/server).
AUTHENTIK_VERSION=2025.6.3

DOGRAH_API_IMAGE=ghcr.io/innotelinc/dograh-api:latest
DOGRAH_UI_IMAGE=ghcr.io/innotelinc/dograh-ui:latest

# ── Capstone-built images (built locally from the Dockerfiles; the release
# pipeline also publishes them to ghcr.io/<this repo>/…) ────────────────────
# Override to pull prebuilt images from a registry instead of building.
N8N_IMAGE=capstone-n8n-otel:local
WORKFLOW_STUDIO_IMAGE=capstone-workflow-studio:local
DASHBOARD_IMAGE=capstone-dashboard:local
DASHBOARD_API_IMAGE=capstone-dashboard-api:local

POSTGRES_PASSWORD=postgres
REDIS_PASSWORD=redissecret
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
# URL n8n (and browsers) use to fetch transcripts/recordings from MinIO on the
# shared interview-net bridge. Upstream proxies /voice-audio/ via nginx;
# locally we point straight at the MinIO container.
MINIO_PUBLIC_ENDPOINT=http://minio:9000

# ══ Coturn TURN server ════════════════════════════════════════════════════
# Use a DNS name or stable public IP for TURN_REALM/TURN_EXTERNAL_IP.
# These credentials are consumed by the Compose service and clients.
# setup.sh automatically replaces these placeholders with generated credentials
# and the detected public IPv4 (or 127.0.0.1 when public-IP detection fails).
TURN_USERNAME=turnuser
TURN_PASSWORD=change-me-turn-password
TURN_REALM=turn.example.com
TURN_EXTERNAL_IP=127.0.0.1
TURN_LISTENING_PORT=3478
# Dedicated relay range; do not overlap Webmin 10000/tcp or Asterisk RTP 10101-10120/udp.
TURN_RELAY_PORT_START=49152
TURN_RELAY_PORT_END=49251

# ══ Local TTS / STT ════════════════════════════════════════════════════════
KOKORO_IMAGE=ghcr.io/remsky/kokoro-fastapi-cpu:latest
SPEACHES_IMAGE=ghcr.io/speaches-ai/speaches:latest-cpu
SPEACHES_WHISPER_DEVICE=cpu          # cpu | cuda | auto
SPEACHES_WHISPER_COMPUTE_TYPE=int8
SPEACHES_WHISPER_MODEL=Systran/faster-distil-whisper-small.en

# ══ LLM gateway (port 20128) ═══════════════════════════════════════════════
# OmniRoute container secrets — openssl rand -base64 48 / -hex 32 / -base64 32
OMNIROUTE_JWT_SECRET=change-me-omniroute-jwt
OMNIROUTE_API_KEY_SECRET=change-me-omniroute-api-key
OMNIROUTE_INITIAL_PASSWORD=change-me-omniroute-admin   # first login to :20128 dashboard
OMNIROUTE_WS_BRIDGE_SECRET=change-me-omniroute-ws
# n8n's grading node sends Authorization: Bearer <key> to the LLM gateway.
# Required: without a key the grader calls the gateway anonymously and gets
# rate-limited (HTTP 429), so executions fail before grading. Mint one in the
# OmniRoute dashboard (Settings → API Keys) or via the API:
#   POST /api/auth/login {password: <OMNIROUTE_INITIAL_PASSWORD>}  -> cookie
#   POST /api/keys {name: <name>}  (Cookie: auth_token=...)        -> {key}
# setup.sh mints this automatically after OmniRoute starts.
OMNIROUTE_API_KEY=

# ══ n8n ════════════════════════════════════════════════════════════════════
N8N_HOST=localhost
N8N_EDITOR_BASE_URL=http://localhost:5678/
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_TIMEZONE=UTC
# openssl rand -base64 32
N8N_USER_MANAGEMENT_JWT_SECRET=change-me-in-env
N8N_OWNER_EMAIL=admin@localhost
N8N_OWNER_PASSWORD=admin123

# Grist doc id — create it with: python3 scripts/grist_bootstrap.py
# (that script creates the doc + Interviews table and prints the id).
GRIST_DOC_ID=
# API key of the Grist user that owns the doc — lets grist_bootstrap.py create
# UI-visible docs (in the user's Home workspace) and the n8n grader authenticate
# its Grist writes. Set from the Grist UI (Profile → API Key) or a user's
# users.api_key in the Grist home DB. setup.sh auto-populates this.
GRIST_API_KEY=change-me-grist-api-key
GRIST_ADMIN_EMAIL=admin@localhost

# n8n AI-assistant sandbox (only if you enable the instance-ai module)
SANDBOX_API_KEYS=change-me-sandbox-api-key
SANDBOX_API_RUNNER_REGISTRATION_TOKEN=change-me-runner-registration-token
SANDBOX_API_RUNNER_API_KEY=change-me-runner-key
SEARXNG_SECRET=change-me-searxng-secret

# ══ SigNoz observability ═══════════════════════════════════════════════════
SIGNOZ_POSTGRES_PASSWORD=signoz
# openssl rand -hex 32
SIGNOZ_JWT_SECRET=change-me-signoz-jwt-secret

# ══ PBX / FreePBX (freepbx service in docker-compose.yml) ══════════════════
HOSTNAME=voice.capstone.innotel.us

# Dograh ARI password — MUST match the "App Password" entered in dograh's
# Telephony Configurations (Stasis App Name: dograh). setup.sh auto-generates.
DOGRAH_ARI_PASSWORD=change-me-ari-password

# Stasis app name dograh GENERATES for the ARI config (dograh_<hex>). The PBX
# dialplan must route into this name, not the ARI username. dograh_wire.py
# fetches it from the config and persists it here automatically — you normally
# don't set this by hand.
DOGRAH_STASIS_APP_NAME=

# LAN subnet offered the LOCAL media address by the pjsip transport (so LAN
# softphones aren't told to send RTP to the public IP — one-way audio). The
# entrypoint injects local_net after FreePBX regenerates the transport config.
PJSIP_LOCAL_NET=192.168.1.0/255.255.255.0
# Host LAN IP LAN-only extensions should advertise for media (avoids one-way
# audio from the container advertising an unreachable docker-bridge IP).
PJSIP_MEDIA_ADDRESS=192.168.1.47
# Space-separated extensions that are LAN-only and thus get media_address.
PJSIP_LAN_ENDPOINTS=101
# STUN/TURN server address Asterisk uses (SIP Settings → RTP + WebRTC).
# Defaults to coturn:<TURN_LISTENING_PORT> — the coturn compose service on
# the same Docker network. Set to the LAN IP / public IP if needed (e.g.
# remote WebRTC clients must also reach the TURN relay, so forward 3478 +
# 49152-49251 on the router). Not host.docker.internal: Asterisk's resolver
# fails on that alias, silently disabling STUN.
# PJSIP_STUN_TURN_ADDR=

# ── dograh ARI telephony config (ansible/dograh-ari.yml) ───────────────────
# The playbook logs in (signup on first run), mints DOGRAH_API_TOKEN (written
# here), and wires the ARI config + inbound routing — no dograh UI needed.
# setup.sh runs scripts/dograh_wire.py, which does the same (plus imports the
# three interview agent workflows and binds extensions 8000/8001/8002).
DOGRAH_ADMIN_EMAIL=ops@capstone.example
# DOGRAH_ADMIN_PASSWORD=            # dograh UI login (created on first run)
# DOGRAH_API_TOKEN=                 # X-API-Key, written by the playbook/setup; when set,
#                                  #   later runs skip login (no admin password needed)

# ── dograh platform source ────────────────────────────────────────────────
# setup.sh shallow-clones the dograh platform source (the image the stack runs
# is built from it) into dograh/upstream (gitignored) for reference and
# optional build-from-source. Override the repo here.
DOGRAH_AGENT_REPO=https://github.com/innotelinc/dograh.git
# Set to 1 to have setup.sh init the pipecat submodule too, so
# docker-compose.dograh-build.yml can build dograh-api from source.
DOGRAH_BUILD_FROM_SOURCE=0

# External-media WebSocket URI Asterisk dials out to. Default reaches host-mode
# dograh-api; change only if dograh is TLS-fronted (then set wss:// + edit
# websocket_client.conf tls_enabled).
DOGRAH_WS_URI=ws://host.docker.internal:8000/api/v1/telephony/ws/ari

# AMI (used by the optional portal profile)
FREEPBX_AMI_USER=pbxportal
FREEPBX_AMI_SECRET=change-me-ami-secret

# FreePBX API module OAuth client — REQUIRED for the API bootstrap script
# (pbx/bootstrap_dograh_route.py). The fullstack entrypoint registers the
# client on boot when both are set. setup.sh auto-generates.
FREEPBX_CLIENT_ID=pbxportal-api
FREEPBX_CLIENT_SECRET=change-me-freepbx-client-secret

# Local/offline build override for the freepbx container
FREEPBX_IMAGE=ghcr.io/innotelinc/pbx-portal:latest-fullstack

# Keep Webmin off the RTP range: Webmin uses host TCP 10000, while Asterisk
# RTP is restricted to UDP 10101-10120 (the published container range).
FREEPBX_WEBMIN_PORT=10000
FREEPBX_RTP_PORT_START=10101
FREEPBX_RTP_PORT_END=10120

# Optional VoIP.ms SIP trunk auto-config — set user+pass and the freepbx
# container's entrypoint writes the pjsip trunk + registration on boot.
VOIPMS_SIP_USER=
VOIPMS_SIP_PASS=
VOIPMS_SIP_SERVER=newyork1.voip.ms
# Map your VoIP.ms DIDs to dograh agent extensions (see README agent table).
# Leave empty to send all inbound trunk calls to ext 8000 (IT mock interview).
# VOIPMS_DIDS=2125551234:8003,2125551235:8005

# Optional: PBX Customer Portal (profile "portal")
SESSION_SECRET=change-me-session-secret

# ─── Infisical (SecretOps) ─────────────────────────────────────────
# Innotel Platform Stack: secrets live in Infisical; .env is derived from it.
# Generate the keys with:
#   openssl rand -base64 32   # INFISICAL_ENCRYPTION_KEY
#   openssl rand -hex 16      # INFISICAL_AUTH_SECRET
#   openssl rand -hex 16      # INFISICAL_DB_PASSWORD
# Then: docker compose -f docker-compose.yml -f compose.infisical.yml \
#         --profile infisical up -d
#       bash scripts/infisical-setup.sh
INFISICAL_PORT=8383
INFISICAL_ENCRYPTION_KEY=
INFISICAL_AUTH_SECRET=
INFISICAL_DB_PASSWORD=
INFISICAL_ADMIN_EMAIL=
INFISICAL_ADMIN_PASSWORD=
INFISICAL_ORG=Innotel
