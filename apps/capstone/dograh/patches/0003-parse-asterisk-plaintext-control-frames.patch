         else:
-            # Text message = JSON control event
+            # Text message = control event. Asterisk frames its external-media
+            # control messages as plaintext, space-separated key:value pairs --
+            #   MEDIA_START connection_id:dograh channel:WebSocket/... \
+            #     channel_id:... format:ulaw optimal_frame_size:160 ptime:20
+            # -- so JSON-only handling warned "Failed to parse JSON message" on
