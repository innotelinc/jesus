+            event = message.get("type") or message.get("event")
+            logger.debug(f"Asterisk WebSocket event: {event} - {message}")
+            return None
+
+    @staticmethod
+    def _parse_plaintext_event(data: str) -> dict | None:
+        """Parse an Asterisk external-media plaintext control frame.
+
+        The media websocket sends ``<EVENT> key:value ...``: ``MEDIA_START``
+        once the media is connected (carrying the negotiated ``format``,
+        ``optimal_frame_size`` and ``ptime``), ``MEDIA_XOFF``/``MEDIA_XON`` as
+        its send buffer fills and drains, and ``MEDIA_STOP`` at the end.
+
+        Returns None when the text is not one of those frames, so a genuinely
+        unexpected payload is still reported rather than swallowed.
+        """
+        parts = data.split()
+        if not parts:
+            return None
+        token = parts[0]
+        # Asterisk spells event names upper-case (MEDIA_START); anything
+        # mixed-case is not one of its frames.
+        if not all(c.isupper() or c.isdigit() or c == "_" for c in token):
+            return None
+        message: dict = {"event": token}
+        for field in parts[1:]:
+            key, _, value = field.partition(":")
+            if key:
+                message[key] = value
+        return message
