# Template for /opt/bulwark/.env.local. Never commit the real file.
#
# The production values are held in Cerulean Vault and written to the host;
# the placeholders below only document the keys this deployment sets.

PORT=3000
HOSTNAME=0.0.0.0

# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-me
ADMIN_PASSWORD=replace-me

JMAP_SERVER_URL=https://mail.example.com
STALWART_ADMIN_ACCESS=auto
STALWART_FEATURES=true
SETTINGS_SYNC_ENABLED=true

OAUTH_ENABLED=true
OAUTH_CLIENT_ID=stalwart-webui
OAUTH_ISSUER_URL=https://auth.example.com/application/o/stalwart-webui/
OAUTH_SCOPES=openid profile email offline_access

APP_NAME=Innotel Mail
APP_SHORT_NAME=Innotel
