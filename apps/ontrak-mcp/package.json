{
  "name": "ontrak-mcp",
  "version": "1.0.0",
  "private": false,
  "description": "A dependency-free Model Context Protocol client and tool bridge for agent consoles, plus a reference stdio server.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/innotelinc/ontrak-mcp.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "agent",
    "tools",
    "json-rpc"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-timeout=60000 dist/test/*.test.js",
    "check": "npm run typecheck && npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
