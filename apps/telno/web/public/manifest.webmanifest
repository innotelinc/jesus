{
  "id": "/scif",
  "name": "Telno SCIF",
  "short_name": "SCIF",
  "description": "A secure line in its own window: encrypted media, withheld caller ID, masked voice and no recording.",
  "start_url": "/softphone?window=1&scif=1",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "portrait",
  "background_color": "#07070d",
  "theme_color": "#07070d",
  "icons": [
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Secure window",
      "short_name": "SCIF",
      "url": "/softphone?window=1&scif=1"
    },
    {
      "name": "Open the console",
      "short_name": "Console",
      "url": "/"
    }
  ]
}
