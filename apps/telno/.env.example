# ---------------------------------------------------------------- platform --
NODE_ENV=production
PORT=8080
HOST=0.0.0.0
# The console, the API, the public site and the subscriber portal are all served
# by this one process, so this is the deployment's main domain. Every directory
# host below needs DNS and a proxy host to this same container — not a second
# deployment.
PUBLIC_URL=https://telno.services

# SIP domain the switch puts in From/To headers (default: the PUBLIC_URL host).
SIP_DOMAIN=telno.services
DATA_DIR=/data
DEFAULT_COUNTRY=US
TRUST_PROXY=true

# First-run owner account. Leave ADMIN_PASSWORD empty to have one generated
# and printed in the container log.
ADMIN_EMAIL=admin@telno.local
ADMIN_PASSWORD=
SESSION_SECRET=          # openssl rand -base64 32
SESSION_DAYS=7

# ----------------------------------------------------------------- devices --
# How often devices are asked to check in, and how long a live device may stay
# quiet before the platform reports it as silent.
DEVICE_CHECKIN_SEC=300
DEVICE_STALE_AFTER_SEC=900

# Call recordings, voicemail audio and fax attachments (defaults to /data/recordings).
RECORDINGS_DIR=/data/recordings
MEDIA_MAX_BYTES=10485760

# --------------------------------------------------------------- telephony --
TELEPHONY_ENABLED=true
# The switch. One URL for the control API, the ARI surface and the browser
# softphone socket; there is no AMI socket, no config directory and no reload
# step — a routing change is one POST to /v1/routes.
CANTUS_URL=http://127.0.0.1:8088
# Bearer token the platform authenticates with. Must equal CANTUS_CONTROL_TOKEN
# on the switch; docker compose sets both from one variable.
CANTUS_CONTROL_TOKEN=    # openssl rand -base64 24
# The dialling domain every extension is addressed in (100@telno.local).
CANTUS_DOMAIN=telno.local
# Where the generated routing document is kept when a switch cannot be reached
# (first boot, or a laptop with no switch running).
CANTUS_CONFIG_DIR=/data/cantus
CANTUS_RECORD_DIR=/data/recordings
# Set to true on a laptop with no switch: the UI and API run, no telephony.
TELEPHONY_SIMULATE=false

# -------------------------------------------------------------- softphone --
# The browser softphone speaks PCM over a WebSocket to the switch (/ws/line);
# no SIP stack, no DTLS-SRTP, no certificate to trust.
SOFTPHONE_ENABLED=true
# Public address of the switch's WSS listener. Leave empty and the softphone
# connects same-origin instead (wss://<console host>/ws), which the app relays to
# the switch: that name is served by the certificate the browser is already on,
# where the switch's own port presents its self-signed one, which a browser
# refuses for a WebSocket with no way past it. Set this to pin another address.
SOFTPHONE_WSS_URL=
SOFTPHONE_WSS_PORT=8089
# Relay the SIP WebSocket through the app (default). Turn it off only on a
# deployment that has installed a real certificate on the listener above, so the
# browser may talk to that port directly.
SOFTPHONE_WSS_RELAY=true
# Where the switch's WSS listener is from inside this container. Only a split
# deployment — the switch on another host — needs to set it.
SOFTPHONE_WSS_INTERNAL=
# A real certificate is expected in production; on first boot a self-signed one
# is generated under ASTERISK_CONFIG_DIR/keys (needs the openssl CLI).
SOFTPHONE_TLS_CERT=
SOFTPHONE_TLS_KEY=
SOFTPHONE_VIDEO=true
# One WebSocket, one short-lived ticket.
SOFTPHONE_TICKET_TTL=120
SOFTPHONE_STUN_URLS=stun:stun.l.google.com:19302
# Optional relay for symmetric NAT. coturn REST credentials: the platform
# hands the browser an expiring username, never this secret.
TURN_URLS=
TURN_SECRET=
TURN_TTL_SEC=3600
# Where the switch writes call recordings (inside the container).
ASTERISK_RECORDING_DIR=/data/recordings

# ------------------------------------------------------------------ voice --
# Recognition runs in the client: the Web Speech API in a browser, Apple's
# SFSpeechRecognizer in the native app. Nothing here is billed per minute.
VOICE_RECOGNITION_ENABLED=true
# Voiceprints are computed by the platform from the audio. A line can require a
# recent check before it is given SIP credentials.
VOICE_AUTH_ENABLED=true
# Cosine similarity. Higher rejects more impostors and more of the owner.
VOICEPRINT_THRESHOLD=0.82
# How long a passed check can be spent on a session.
VOICEPRINT_TICKET_TTL=300
VOICEPRINT_MIN_SECONDS=1
VOICEPRINT_MAX_SECONDS=20
# Per line, per hour. A voiceprint is a check, not a place to guess.
VOICEPRINT_ATTEMPTS_PER_HOUR=20

# ------------------------------------------------------------ apple push --
# A VoIP push is the only thing that makes a locked iPhone ring. APNs is free:
# create a key (Apple developer portal -> Keys -> APNs) and keep the .p8 on the
# data volume. Never commit it. See native/README.md.
APNS_ENABLED=false
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=us.innotel.scif
# development (sandbox / Xcode build) or production (TestFlight, App Store).
APNS_ENVIRONMENT=development
# Ring the phone when the switch says its line is ringing and no app is open.
APNS_RING_ON_DIAL=true

# ---------------------------------------------------------------- parking --
# How a call reaches a phone that was asleep when it arrived. The desk phone and
# an open browser ring first; then the caller is parked in a numbered space and
# the push names it, so answering dials the space and joins the call.
# Parking only applies to a line with a phone registered against it.
PARKING_ENABLED=true
PARKING_LOT=telno
# The lot must live in 7000-7999: a space is dialed as _7XXX.
PARKING_START=7001
PARKING_END=7099
# How long the desk phone and any open browser ring before the call is parked.
PARKING_RING_SECONDS=12
# How long the caller waits in the space before the line's voicemail answers.
PARKING_TIMEOUT=35
PARKING_MOH=default

# --------------------------------------------------------------- directory --
DIRECTORY_DOMAINS=telno.directory,num.directory,number.directory,directory.telno.services,directory.pbx.services,directory.pbx.technology
DIRECTORY_CANONICAL=telno.directory
DIRECTORY_MAX_RESULTS=50
SUBMISSION_LIMIT_PER_HOUR=5
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5

# Outbound delivery. Email uses Resend whenever a key exists — store it in
# Settings → Email delivery (the vault) and no restart is needed. The variables
# below are the alternative for a compose-driven deployment; the vault wins.
NOTIFY_CHANNEL=console
NOTIFY_FROM=directory@telno.directory
# Which email provider sends: resend | mailjet. Better set in Settings, where
# it is stored in the vault and takes effect without a restart.
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_...
# RESEND_API_URL=https://api.resend.com
# Mailjet needs both halves of the pair.
# MAILJET_API_KEY=...
# MAILJET_API_SECRET=...
# MAILJET_API_URL=https://api.mailjet.com
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_FROM=+14155550100

# Automatic payment reminders. One goes out on each rung, measured in days
# after the due date, and never twice inside the gap — so a restart or a manual
# sweep cannot duplicate one. Set REMINDER_ENABLED=false to stop the timer.
REMINDER_ENABLED=true
REMINDER_DAYS=1,3,7,14,30
REMINDER_SWEEP_MINUTES=30
REMINDER_GAP_HOURS=20

# Escalation. At FINAL_NOTICE_DAYS past due one final notice replaces the last
# reminder and names the day service stops: that date plus SUSPEND_GRACE_DAYS.
# On that day the account's extensions are switched off and its logins blocked
# (never an owner), and paying restores everything on the next sweep. Set
# ESCALATION_ENABLED=false to warn nobody and switch nobody off.
ESCALATION_ENABLED=true
FINAL_NOTICE_DAYS=30
SUSPEND_GRACE_DAYS=14

# Pay button in the notices, through Stripe's hosted page. Prefer storing both
# values in Settings → Vault (STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET): a vault
# key wins over these and can be rotated without a rebuild. The webhook endpoint
# to register in Stripe is https://<PUBLIC_URL host>/api/public/stripe/webhook.
PAYMENTS_ENABLED=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ----------------------------------------------------------- number provider ---
# Numbers are searched, bought and released at VoIP.ms. Prefer storing both API
# values in Settings → Vault (VOIPMS_API_USERNAME, VOIPMS_API_PASSWORD): a vault
# value wins over these and can be rotated without a rebuild. The API password is
# generated under Main Menu → SOAP & REST/JSON API in the VoIP.ms portal, which
# is also where this server's address has to be allow-listed.
VOIPMS_API_USERNAME=
VOIPMS_API_PASSWORD=
# Where a bought DID rings, as a VoIP.ms routing string (account:100001_telno).
# Without it every order has to name a routing target.
VOIPMS_ROUTING=
VOIPMS_POP=1
# 1 = per minute, 2 = flat monthly.
VOIPMS_BILLING_TYPE=2
VOIPMS_DIAL_TIME=60
VOIPMS_CNAM=false
# What a DID costs per month, in cents, recorded against the account that holds
# it. 0 means "not priced yet", not "free".
VOIPMS_DID_MONTHLY_CENTS=85
VOIPMS_CURRENCY=USD
# Rent on the customer's bill. Each rented number's monthly cost is recorded in
# the ledger, then added to that account's invoice as its own line. Set to false
# to keep the ledger and stop invoicing it.
RENT_INVOICING_ENABLED=true

# ---------------------------------------------------------------------- AI ---
# Campaign grading, campaign suggestions and the operations autopilot go through
# one OpenAI-compatible gateway. Prefer storing the key in
# Settings → Vault (LLM_API_KEY): a vault key wins over this and can be rotated
# without a rebuild. Without a key the platform still works — grading falls back
# to rules and the console says which one ran.
AI_ENABLED=true
LLM_BASE_URL=https://gateway.innotel.us/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=30000
# LLM_API_KEY=

# ------------------------------------------------------------ subscriptions ---
# The public pricing page. The same container serves it, but it is linked as its
# own hostname so a prospect never lands in the console.
SUBSCRIBE_URL=https://subscribe.telno.services

# The subscriber system of record. Every plan change is posted here, so the
# catalog on the public page and the catalog in billing cannot drift apart.
# Also storable in the vault (MAGNATE_WEBHOOK_URL, MAGNATE_API_TOKEN).
# MAGNATE_WEBHOOK_URL=https://.../hooks/telno
# MAGNATE_API_TOKEN=

# ---------------------------------------------------------------------- fax --
# Fax runs on the switch (res_fax + spandsp), over the SIP trunk calls already
# use. There is no carrier fax API and no per-page charge: a fax is a call.
FAX_ENABLED=true
# true offers T.38 on the trunk; false sends the page as G.711 audio through
# spandsp. There is no fallback after a carrier refuses T.38 mid-call, so a
# carrier that answers the renegotiation with 488 (VoIP.ms does) needs false.
FAX_T38=true
FAX_STATION_ID=Telno
# Received documents and outbound staging files. Default: $DATA_DIR/faxes.
# FAX_DIR=/data/faxes
# FAX_MAX_RATE=14400
# FAX_SWEEP_SECONDS=15

# ------------------------------------------------------- desk-phone setup --
# Hands get their configuration from this platform by MAC: DHCP Option 66, or
# the provisioning URL field, points at PROVISIONING_URL. The SIP domain in
# every generated config is PROVISIONING_SIP_DOMAIN, so a handset registers as
# sip:<extension>@telno.tel — the same name the console shows.
PROVISIONING_ENABLED=true
PROVISIONING_URL=https://telno.tel
PROVISIONING_SIP_DOMAIN=telno.tel
PROVISIONING_SIP_PORT=5060

# The SIP domain the switch puts in From/To headers. Set it when the URI a
# customer hands out (sip:100@telno.tel) is not the web hostname.
# SIP_DOMAIN=telno.tel
