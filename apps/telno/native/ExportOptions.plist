<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Export options for the TestFlight / App Store build. CI substitutes __TEAM_ID__
  before handing it to `xcodebuild -exportArchive`. Destination "export" writes
  the .ipa without uploading, so the workflow uploads with `xcrun altool` and
  keeps the artifact — a failed upload is then a retry, not a rebuild.
-->
<plist version="1.0">
<dict>
	<key>method</key>
	<string>app-store-connect</string>
	<key>destination</key>
	<string>export</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<key>teamID</key>
	<string>__TEAM_ID__</string>
	<key>uploadSymbols</key>
	<true/>
	<!-- The build number is CI's run number; do not let Xcode rewrite it. -->
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
</dict>
</plist>
