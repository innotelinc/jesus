; A SIP door, because a carrier cannot speak IAX2.
;
; The modem path (IAX2) is internal and loopback-bound; this is the one place a
; fax call can enter from outside. It is only meaningful when the estate gives
; the fax its own sub-account: a fax DID has to arrive here directly, not
; through the Cantus switch, which carries voice only and would transcode the
; modem tones it was never meant to carry.
[global]
type=global
user_agent=Telno fax (Cantus estate)

[transport-udp]
type=transport
protocol=udp
bind=0.0.0.0:__SIP_BIND_PORT__
allow_reload=yes
; One placeholder per line on purpose. Both addresses used to be substituted as
; a single two-line value, and `sed` reads the newline in a replacement as the
; end of the command — so any host that set PUBLIC_IP failed to render this file
; at all, with "unterminated `s' command" and no mention of the address.
; __SIP_EXTERNAL_MEDIA__
; __SIP_EXTERNAL_SIGNALING__
