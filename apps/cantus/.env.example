# ==========================================================================
# Cantus — environment template
#
# Cantus is a protocol and a dependency-free Perl reference stack: it needs no
# service credentials to run a call on loopback. Nothing here is required for
# `make test` or `bin/cantus demo`.
#
# Copy to `.env` only if you are operating something (a relay, a node with a
# real identity). Never commit `.env` — it is gitignored, and this template is
# the thing that gets committed.
#
# Production secrets come from Cerulean Vault (SecretOps, KV v2), not from a
# file in the tree. Values below may be written as
#   RELAY_SECRET=vault://cerulean/cantus#RELAY_SECRET
# and resolved at startup by whatever wrapper launches the node.
# ==========================================================================

# --- Node identity ----------------------------------------------------------
# The reference stack ships a loopback-only test identity (`sig-hmac-sha256`).
# A real node needs an Ed25519 key and a transport binding; see spec §10.
NODE_ID=alice@example.invalid
NODE_BIND=127.0.0.1:0

# --- Relay ------------------------------------------------------------------
# Relay address advertised to nodes. Registration opens the mapping, so this
# must be reachable before the first call, not at call time.
RELAY_ADDR=127.0.0.1:7443
# Shared secret for the conformance signature profile. Loopback only.
RELAY_SECRET=

# --- Cerulean Vault (SecretOps) --------------------------------------------
# Path-scoped policy per repo: this repo reads `cerulean/cantus`.
VAULT_ADDR=
VAULT_TOKEN_FILE=
VAULT_PREFIX=cerulean
VAULT_PATH=cantus
